{
	"name": "ranma-site",
	"private": true,
	"description": "ranma.masshiro.pro: built from these files into build/, served as plain files. doc/WEBSITE.md.",
	"license": "MIT OR Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "node build.mjs",
		"test": "node --test 'test/*.test.mjs'",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-coverage-include='lib/**' --test-coverage-include=build.mjs 'test/*.test.mjs'",
		"pretest:e2e": "node build.mjs",
		"test:e2e": "playwright test",
		"serve": "node scripts/serve.mjs",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint-staged": "lint-staged",
		"hooks:check": "node scripts/hooks-armed.mjs",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/ibm-plex-sans": "5.3.0",
		"@fontsource/shippori-mincho": "5.3.0",
		"@playwright/test": "1.60.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "3.6.2"
	},
	"packageManager": "yarn@1.22.22"
}
